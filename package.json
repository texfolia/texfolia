{
  "name": "texfolia",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "auth:schema": "bun run --cwd apps/app auth:schema",
    "build": "turbo run build",
    "cf:typegen": "turbo run cf:typegen",
    "changeset": "changeset",
    "check:repo": "bun run scripts/check-repo.mjs",
    "db:generate": "bun run --cwd packages/db db:generate",
    "db:migrate": "bun run --cwd packages/db db:migrate",
    "db:push": "bun run --cwd packages/db db:push",
    "db:seed": "bun run --cwd packages/db db:seed",
    "db:start": "docker compose up --wait db",
    "db:stop": "docker compose stop",
    "deploy": "turbo run deploy",
    "dev": "bun run db:start && turbo run dev",
    "dev:app": "bun run db:start && turbo run dev --filter=app",
    "dev:compiler": "turbo run dev --filter=compiler",
    "dev:docs": "turbo run dev --filter=docs",
    "dev:web": "turbo run dev --filter=web",
    "format": "oxfmt && turbo run format",
    "format:check": "oxfmt --check && turbo run format:check",
    "lint": "bun run check:repo && oxlint && turbo run lint",
    "lint:fix": "oxlint --fix",
    "release": "turbo run build --filter=@texfolia/codemirror-lang-latex --filter=@texfolia/tex-fmt --filter=@texfolia/editor && changeset publish",
    "setup": "bun run scripts/setup.ts",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.4",
    "@types/bun": "^1.4.4",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2008",
    "postcss": "8.5.33",
    "turbo": "2.11.10"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.4"
    }
  }
}

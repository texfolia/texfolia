{
  "name": "texfolia",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "auth:schema": "turbo run auth:schema",
    "build": "turbo run build",
    "build:production": "turbo run build:production",
    "build:staging": "turbo run build:staging",
    "cf:typegen": "turbo run cf:typegen",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:push": "turbo run db:push",
    "db:setup": "docker compose up --wait db",
    "deploy": "turbo run deploy",
    "dev": "turbo run dev",
    "dev:stop": "turbo run dev:stop",
    "dev:workers": "turbo run dev:workers",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "format:check:repo": "oxfmt --check",
    "format:repo": "oxfmt",
    "lint": "turbo run lint",
    "lint:repo": "oxlint",
    "smoke": "turbo run smoke",
    "smoke:workers": "turbo run smoke:workers",
    "stripe:listen": "turbo run stripe:listen",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@texfolia/typescript-config": "workspace:*",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "turbo": "latest"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.4"
    }
  }
}

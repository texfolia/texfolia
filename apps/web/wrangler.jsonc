{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tanstack-start-app",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/worker.ts",
  "r2_buckets": [{ "binding": "SOURCES", "bucket_name": "texfolia-sources" }],
  "triggers": { "crons": ["17 * * * *"] },
  "services": [
    {
      "binding": "COMPILER",
      "service": "texfolia-compiler",
    },
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 },
  },
  "send_email": [
    {
      "name": "EMAIL",
    },
  ],
  "vars": {
    "EMAIL_FROM": "noreply@texfolia.com",
    "TURNSTILE_HOSTNAMES": "www.texfolia.com",
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "<local-only; configure production or staging before deploying>",
    },
  ],
  "env": {
    "production": {
      "name": "texfolia-web",
      "r2_buckets": [
        { "binding": "SOURCES", "bucket_name": "texfolia-sources" },
      ],
      "hyperdrive": [
        { "binding": "HYPERDRIVE", "id": "<production hyperdrive id>" },
      ],
      "services": [{ "binding": "COMPILER", "service": "texfolia-compiler" }],
      "send_email": [{ "name": "EMAIL" }],
      "vars": {
        "EMAIL_FROM": "noreply@texfolia.com",
        "TURNSTILE_HOSTNAMES": "www.texfolia.com",
      },
    },
    "staging": {
      "name": "texfolia-web-staging",
      "r2_buckets": [
        { "binding": "SOURCES", "bucket_name": "texfolia-sources-staging" },
      ],
      "hyperdrive": [
        { "binding": "HYPERDRIVE", "id": "<staging hyperdrive id>" },
      ],
      "services": [
        { "binding": "COMPILER", "service": "texfolia-compiler-staging" },
      ],
      "send_email": [{ "name": "EMAIL" }],
      "vars": {
        "EMAIL_FROM": "noreply@texfolia.com",
        "TURNSTILE_HOSTNAMES": "<staging hostname>",
      },
    },
  },
}

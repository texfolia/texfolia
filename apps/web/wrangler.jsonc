{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "texfolia-web-local",
  "main": "src/worker.ts",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
  },
  "env": {
    "production": {
      "name": "texfolia-web",
    },
  },
}

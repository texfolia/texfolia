{
  "name": "web",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "auth:generate": "bun --env-file=../../packages/db/.env x --bun auth@latest generate --output ../../packages/db/src/db/auth-schema.ts --config ./src/lib/auth.ts --yes",
    "build": "vite build",
    "deploy": "bun run build && wrangler deploy",
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@better-auth/drizzle-adapter": "^1.7.14",
    "@better-auth/stripe": "^1.7.14",
    "@daypicker/react": "^10.0.2",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "0.10.14",
    "@tanstack/react-form-start": "^1.33.5",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-start": "1.169.4",
    "@tanstack/react-table": "^9.3.1",
    "@texfolia/db": "workspace:*",
    "@uiw/react-codemirror": "^4.25.12",
    "better-auth": "^1.7.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.1",
    "date-fns": "^4.4.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.66.0",
    "motion": "^14.9.0",
    "react": "^19.2.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.2.0",
    "react-resizable-panels": "^4.16.0",
    "shadcn": "^4.23.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.26.0",
    "@tanstack/devtools-vite": "0.8.6",
    "@tanstack/router-cli": "^1.132.0",
    "@texfolia/typescript-config": "workspace:*",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",

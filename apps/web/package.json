{
  "name": "web",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "build": "CLOUDFLARE_ENV=production vite build",
    "cf:typegen": "wrangler types --include-runtime=false --strict-vars=false && oxfmt worker-configuration.d.ts",
    "deploy": "wrangler deploy --env production",
    "dev": "vite dev --port 4321 --strictPort",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "generate-routes": "vite build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "preview": "vite preview --port 4321 --strictPort",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "@texfolia/contracts": "workspace:*",
    "@texfolia/ui": "workspace:*",
    "cn": "^0.5.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.26.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/devtools-vite": "0.8.6",
    "@tanstack/react-devtools": "0.10.14",
    "@tanstack/react-router-devtools": "1.167.2",
    "@types/bun": "^1.4.4",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "^6.0.2",
    "vite": "^8.3.6",
    "wrangler": "^4.70.0"
  }
}

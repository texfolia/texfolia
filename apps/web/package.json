{
  "name": "web",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "auth:schema": "bunx auth generate --output ../../packages/db/src/db/auth-schema.ts --config ./auth.config.ts --yes",
    "build": "bun run latex:assets && vite build",
    "cf:typegen": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler types --strict-vars=false",
    "deploy": "wrangler deploy",
    "dev": "bun run latex:assets && vite dev --port 3000 --strictPort",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "generate-routes": "tsr generate",
    "latex:assets": "wasm-latex-tools copy-assets ./public/core",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "preview": "vite preview",
    "test": "bun test",
    "test:collaboration": "bun run test/collaboration.ts",
    "test:production-assets": "bun run test/production-assets.ts",
    "test:workspace-upload": "bun run test/workspace-upload.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@better-auth/drizzle-adapter": "1.7.15",
    "@better-auth/stripe": "^1.7.15",
    "@codemirror/autocomplete": "^6.20.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.0",
    "@codemirror/search": "^6.7.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@iconify-react/thesvg": "gitlab:iconify-icons/react#thesvg",
    "@iconify-react/thesvg-color": "gitlab:iconify-icons/react#thesvg-color",
    "@lezer/highlight": "^1.2.5",
    "@tabler/icons-react": "^3.50.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/markdown": "^1.2.0",
    "@tanstack/react-db": "^1.0.0-rc.1.4",
    "@tanstack/react-devtools": "0.10.14",
    "@tanstack/react-form-start": "^1.33.5",
    "@tanstack/react-hotkeys": "^0.22.0",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-start": "1.169.4",
    "@tanstack/react-table": "^9.3.1",
    "@texfolia/db": "workspace:*",
    "@uiw/codemirror-themes": "^4.25.12",
    "@uiw/codemirror-themes-all": "^4.25.12",
    "@uiw/react-codemirror": "^4.25.12",
    "better-auth": "1.7.15",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "codemirror-lang-latex": "^0.6.1",
    "diff": "^8.0.4",
    "dockview-react": "^8.8.3",
    "drizzle-orm": "^1.0.0-rc.5",
    "input-otp": "^1.5.0",
    "lib0": "^0.2.120",
    "motion": "^14.10.1",
    "pdfjs-dist": "6.3.289",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-pdf": "^11.0.0",
    "react-turnstile": "^1.1.5",
    "shadcn": "^4.23.0",
    "stripe": "^23.1.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "wasm-latex-tools": "^0.2.0",
    "y-codemirror.next": "^0.3.6",
    "y-indexeddb": "^9.0.12",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.26.0",
    "@cloudflare/workers-types": "5.20261031.1",
    "@tanstack/devtools-vite": "0.8.6",
    "@tanstack/router-cli": "^1.132.0",
    "@texfolia/typescript-config": "workspace:*",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "esbuild": "0.25.12",
    "miniflare": "5.20261023.3-beta",
    "playwright": "^1.61.0",
    "typescript": "^6.0.2",
    "vite": "^8.3.6",
    "wrangler": "^4.70.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss",
      "sharp",
      "workerd"
    ]
  }
}

    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/lint": "^6.9.0",
    "@codemirror/search": "^6.7.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@iconify-react/thesvg": "gitlab:iconify-icons/react#thesvg",

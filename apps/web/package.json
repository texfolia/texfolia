  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@tailwindcss/vite": "^4.3.3",
    "@texfolia/config": "workspace:*",
    "typescript": "^6.0.2",
    "wrangler": "^4.70.0"
  }

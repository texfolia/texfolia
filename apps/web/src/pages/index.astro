---
export const prerender = true;

import BaseLayout from "@/layouts/BaseLayout.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import { appPath } from "@/lib/urls";

const login = appPath("/login");
const workspace = appPath("/projects");
---

<BaseLayout title="Space for your next great paper | Texfolia">
  <div class="flex min-h-svh flex-col">
    <Header />
    <main id="main-content">
      <section
        class="mx-auto grid max-w-7xl gap-8 px-6 pt-16 pb-14 sm:px-8 sm:pt-24 lg:grid-cols-[1.3fr_1fr] lg:items-end lg:gap-16 lg:pb-20"
      >
        <h1
          class="max-w-3xl font-serif text-6xl leading-[1.02] tracking-[-0.035em] text-balance sm:text-8xl lg:text-[6rem]"
        >
          Good ideas
          <br />
          deserve a<br />
          <span class="italic">great paper.</span>
        </h1>
        <div class="max-w-md lg:pb-2">
          <p class="text-lg leading-relaxed text-muted-foreground sm:text-xl">
            A focused LaTeX workspace for the work that matters. Write,
            collaborate, and compile your next paper, right in your browser.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href={login} class="btn btn-primary btn-lg">
              Start writing
              <span aria-hidden="true">→</span>
            </a>
            <a href="/templates" class="btn btn-outline btn-lg">
              Find a template
            </a>
          </div>
        </div>
      </section>
      <section
        aria-label="An illustrative LaTeX workspace"
        class="border-y bg-muted/50 px-4 py-8 sm:px-8 sm:py-14"
      >
        <div class="mx-auto max-w-6xl overflow-hidden border bg-background">
          <div
            class="flex items-center justify-between border-b px-4 py-3 text-xs"
          >
            <span class="font-medium">A study of small things</span>
            <span class="text-muted-foreground">Illustrative workspace</span>
          </div>
          <div class="grid min-h-80 md:grid-cols-[1fr_1fr_160px]">
            <div
              class="overflow-hidden border-b p-5 font-mono text-xs leading-7 text-muted-foreground sm:p-8 sm:text-sm md:border-r md:border-b-0"
            >
              <div
                class="mb-5 flex items-center gap-2 font-sans text-xs text-foreground"
              >
                main.tex
              </div>
              <pre>{`\\documentclass{article}
\\usepackage{amsmath}

\\title{A study of small things}
\\author{A curious mind}

\\begin{document}
\\maketitle

\\section{The question}
Every discovery begins with
something worth asking.

\\[ E = mc^2 \\]
\\end{document}`}</pre>
            </div>
            <div class="bg-muted p-6 sm:p-10">
              <article
                class="mx-auto min-h-96 max-w-sm bg-white px-7 py-12 font-serif text-[#242424] shadow-sm sm:px-10"
              >
                <h2 class="text-center text-2xl leading-tight">
                  A study of small things
                </h2>
                <p class="mt-4 text-center text-xs">A curious mind</p>
                <h3 class="mt-12 text-lg font-bold">1&nbsp; The question</h3>
                <p class="mt-4 text-sm leading-6">
                  Every discovery begins with something worth asking.
                </p>
                <p class="mt-10 text-center text-2xl italic">E = mc²</p>
                <p class="mt-16 text-center text-xs">1</p>
              </article>
            </div>
            <div class="hidden border-l text-xs md:block">
              <p class="border-b px-3 py-2 font-medium">Files</p>
              <p class="px-3 py-2">My paper</p>
              <p class="bg-muted px-3 py-2">main.tex</p>
            </div>
          </div>
        </div>
      </section>
      <section
        class="mx-auto grid max-w-7xl gap-12 px-6 py-20 sm:px-8 lg:grid-cols-[1fr_1.2fr] lg:gap-24 lg:py-28"
      >
        <h2
          class="max-w-md font-serif text-4xl leading-tight tracking-tight sm:text-5xl"
        >
          From the first line
          <br />
          to the final draft.
        </h2>
        <div class="divide-y">
          <div class="flex gap-5 py-7 first:pt-0">
            <div>
              <h3 class="text-lg font-medium">Your source. Your workspace.</h3>
              <p class="mt-2 max-w-lg leading-relaxed text-muted-foreground">
                Keep LaTeX, references, and figures together. Edit your source
                alongside the PDF and download your files when you need them.
              </p>
            </div>
          </div>
          <div class="flex gap-5 py-7">
            <div>
              <h3 class="text-lg font-medium">Better, together.</h3>
              <p class="mt-2 max-w-lg leading-relaxed text-muted-foreground">
                Share a project with readers or editors. Work on the same
                documents in real time, without passing files back and forth.
              </p>
            </div>
          </div>
          <div class="flex gap-5 py-7 last:pb-0">
            <div>
              <h3 class="text-lg font-medium">Room to change your mind.</h3>
              <p class="mt-2 max-w-lg leading-relaxed text-muted-foreground">
                Compare document versions, name the milestones, and restore an
                earlier draft when you need a fresh start.
              </p>
            </div>
          </div>
        </div>
      </section>
      <section class="border-t bg-muted/40 px-6 py-16 text-center sm:py-24">
        <h2 class="font-serif text-4xl tracking-tight sm:text-6xl">
          What will you write next?
        </h2>
        <p class="mt-5 text-muted-foreground">
          Start with a blank page or make a template your own.
        </p>
        <a href={workspace} class="btn btn-primary btn-lg mt-8">
          Open your workspace
          <span aria-hidden="true">→</span>
        </a>
      </section>
    </main>
    <Footer />
  </div>
</BaseLayout>

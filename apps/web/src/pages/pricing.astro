---
export const prerender = true;

import { paidPlans } from "@texfolia/auth/billing";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import { appPath } from "@/lib/urls";

const storagePolicy = "10 MiB per source file; 50 MiB per project";

const plans = [
  {
    name: "Free",
    description: "For learning LaTeX and writing together.",
    price: 0,
    priceUnit: "",
    buttonVariant: "outline" as const,
    buttonText: "Get started for free",
    href: appPath("/projects"),
    features: [
      "No project or editor count limit",
      storagePolicy,
      "GitHub and GitLab integration",
      "15-second compile timeout",
      "No AI assistant",
    ],
  },
  {
    name: paidPlans.pro.name,
    description: "For longer compiles and an AI writing assistant.",
    price: paidPlans.pro.monthlyUsd,
    priceUnit: "/month",
    buttonVariant: "primary" as const,
    buttonText: "Upgrade to Pro",
    href: appPath("/settings/billing?plan=pro"),
    features: [
      "No project or editor count limit",
      storagePolicy,
      "GitHub and GitLab integration",
      "5-minute compile timeout",
      "AI assistant, billed separately at model cost + 20%",
      "Monthly metered AI billing with a per-user spend cap",
    ],
  },
  {
    name: paidPlans.team.name,
    description: "Pro for every user, with one shared organization bill.",
    price: paidPlans.team.monthlyUsd,
    priceUnit: "/user/month",
    buttonVariant: "outline" as const,
    buttonText: "Upgrade to Team",
    href: appPath("/settings/billing?plan=team"),
    features: [
      "Pro benefits for every organization member",
      "No project or editor count limit",
      storagePolicy,
      "GitHub and GitLab integration",
      "5-minute compile timeout",
      "AI assistant, billed separately at model cost + 20%",
      "Monthly metered AI billing with a per-user spend cap",
      "Shared billing; seats follow membership",
    ],
  },
];

const comparison = [
  ["Projects", "No count limit", "No count limit", "No count limit"],
  ["Editors per project", "No count limit", "No count limit", "No count limit"],
  ["Source storage", storagePolicy, storagePolicy, storagePolicy],
  [
    "Git version history",
    "GitHub and GitLab integration",
    "GitHub and GitLab integration",
    "GitHub and GitLab integration",
  ],
  ["Compile timeout", "15 seconds", "5 minutes", "5 minutes"],
  [
    "AI assistant",
    "Not included",
    "Model cost + 20%",
    "Model cost + 20% per user",
  ],
  [
    "AI billing",
    "Not available",
    "Metered; invoiced monthly",
    "Metered; shared monthly invoice",
  ],
  [
    "AI spend cap",
    "Not available",
    "Per user; default $20/month",
    "Per user; default $20/month",
  ],
  [
    "Subscription billing",
    "Free",
    "Personal",
    "$20/user/month; shared organization bill",
  ],
];
---

<BaseLayout title="Pricing | Texfolia">
  <div class="flex min-h-svh flex-col">
    <Header />
    <main
      id="main-content"
      class="mx-auto w-full max-w-7xl px-6 py-16 sm:px-8 sm:py-24"
    >
      <h1 class="font-serif text-6xl tracking-tight sm:text-7xl">
        Space to do your best work.
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted-foreground">
        Choose the plan that's right for you and your team.
      </p>
      <div class="mt-14 grid gap-5 md:grid-cols-3">
        {
          plans.map((plan) => (
            <article class="flex h-full flex-col border py-8">
              <div class="space-y-4 px-6">
                <h2 class="text-xl font-semibold">{plan.name}</h2>
                <p class="min-h-12 leading-6 text-muted-foreground">
                  {plan.description}
                </p>
                <p class="text-5xl font-medium tracking-tight tabular-nums">
                  ${plan.price}
                  {plan.priceUnit && (
                    <span class="ml-1 text-sm font-normal tracking-normal text-muted-foreground">
                      {plan.priceUnit}
                    </span>
                  )}
                </p>
              </div>
              <div class="px-6 pt-6">
                <a
                  href={plan.href}
                  class:list={[
                    "btn btn-lg w-full",
                    plan.buttonVariant === "primary"
                      ? "btn-primary"
                      : "btn-outline",
                  ]}
                >
                  {plan.buttonText}
                </a>
              </div>
              <ul class="mt-auto space-y-4 px-6 pt-8 text-sm">
                {plan.features.map((feature) => (
                  <li class="flex items-start gap-3">
                    <span class="mt-0.5 text-muted-foreground" aria-hidden="true"
                      >✓</span
                    >
                    {feature}
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
      <p class="mt-5 text-sm text-muted-foreground">
        Prices are in USD. AI usage is extra, reported to Stripe after each run
        and invoiced monthly. The launch markup is 20%; each user can adjust
        their monthly AI spend cap, including setting it to $0 to pause AI.
      </p>
      <section class="mt-12 border p-6">
        <h2 class="mb-4 text-xl font-semibold">Compare plans</h2>
        <p class="mb-4 text-sm text-muted-foreground md:hidden">
          Scroll horizontally to compare all plans.
        </p>
        <div class="overflow-x-auto">
          <table class="min-w-3xl w-full text-left text-sm" aria-label="Plan comparison">
            <caption class="mt-4 text-left text-muted-foreground">
              Plan limits apply equally to personal and organization projects.
              Compilation is subject to fair use.
            </caption>
            <thead>
              <tr class="border-b">
                <th class="py-3 pr-4 font-medium">Feature</th>
                <th class="py-3 pr-4 font-medium">Free</th>
                <th class="py-3 pr-4 font-medium">Pro</th>
                <th class="py-3 font-medium">Team</th>
              </tr>
            </thead>
            <tbody>
              {
                comparison.map(([feature, ...values]) => (
                  <tr class="border-b">
                    <th scope="row" class="py-3 pr-4 font-medium whitespace-normal">
                      {feature}
                    </th>
                    {values.map((value) => (
                      <td class="py-3 pr-4 whitespace-normal last:pr-0">{value}</td>
                    ))}
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </section>
      <p class="mt-8 text-sm text-muted-foreground">
        Compilation on every plan is subject to{" "}
        <a href="/terms" class="underline underline-offset-4">fair use</a>.
      </p>
    </main>
    <Footer />
  </div>
</BaseLayout>

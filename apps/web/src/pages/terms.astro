---
export const prerender = true;

import PolicyLayout from "@/components/PolicyLayout.astro";
import { appPath } from "@/lib/urls";

const accountSettings = appPath("/settings/account");

const sections = [
  { id: "service", title: "About the service" },
  { id: "accounts-and-use", title: "Accounts and acceptable use" },
  { id: "content-and-sharing", title: "Your content and shared projects" },
  { id: "templates", title: "Templates and licenses" },
  { id: "billing", title: "Subscriptions and AI billing" },
  { id: "fair-use", title: "Fair use" },
  { id: "assistant", title: "Using the assistant" },
  { id: "exports-and-deletion", title: "Exports and deletion" },
  { id: "termination", title: "Suspension and termination" },
  { id: "legal-terms", title: "Availability, liability, and disputes" },
  { id: "terms-changes", title: "Changes and contact" },
];
---

<PolicyLayout
  title="Terms of service"
  documentTitle="Terms of service template | Texfolia"
  sections={sections}
>
  <section id="service" aria-labelledby="service-heading" class="scroll-mt-8 border-t pt-8">
    <h2 id="service-heading" class="text-xl font-semibold text-balance">About the service</h2>
    <div class="mt-4 max-w-prose space-y-4 leading-7 [&_a]:underline [&_a]:underline-offset-4">
      <p>
        Texfolia provides an online LaTeX workspace with project storage,
        compilation, collaboration, optional Git history, reviewed templates, and
        a managed AI assistant. Available plans and features are described on the{" "}
        <a href="/pricing">pricing page</a>.
      </p>
      <p class="text-sm leading-6 text-muted-foreground">
        <span class="font-medium text-foreground">To be completed.</span> Identify
        the legal operator, contact details, effective date, and how users accept
        the final terms.
      </p>
    </div>
  </section>

  <section id="accounts-and-use" aria-labelledby="accounts-and-use-heading" class="scroll-mt-8 border-t pt-8">
    <h2 id="accounts-and-use-heading" class="text-xl font-semibold text-balance">Accounts and acceptable use</h2>
    <div class="mt-4 max-w-prose space-y-4 leading-7">
      <p class="text-sm leading-6 text-muted-foreground">
        <span class="font-medium text-foreground">To be completed.</span> Define
        eligibility and age requirements, account responsibilities, prohibited
        uses, abuse handling, and the process for content or copyright complaints.
      </p>
    </div>
  </section>

  <section id="content-and-sharing" aria-labelledby="content-and-sharing-heading" class="scroll-mt-8 border-t pt-8">
    <h2 id="content-and-sharing-heading" class="text-xl font-semibold text-balance">Your content and shared projects</h2>
    <div class="mt-4 max-w-prose space-y-4 leading-7">
      <p>
        Personal-project owners manage view and edit access for existing Texfolia
        accounts. Organization projects use organization membership. People with
        access can read and download project files; editors can change saved
        content. Removing access does not remove copies already downloaded or
        saved elsewhere.
      </p>
      <p class="text-sm leading-6 text-muted-foreground">
        <span class="font-medium text-foreground">To be completed.</span> Add
        content ownership wording and the permission Texfolia needs to store,
        process, compile, share, and publish content. Define responsibility for
        uploaded and shared material.
      </p>
    </div>
  </section>

  <section id="templates" aria-labelledby="templates-heading" class="scroll-mt-8 border-t pt-8">
    <h2 id="templates-heading" class="text-xl font-semibold text-balance">Templates and licenses</h2>
    <div class="mt-4 max-w-prose space-y-4 leading-7">
      <p>
        Publishing creates a separate snapshot of saved project files.
        Submissions require confirmation of redistribution rights under the
        selected license and review before public access. Approved unlisted
        templates can be accessed by anyone with their URL. The displayed license
        applies to the source distribution. Downloads and project copies do not
        track later changes to the original project.
      </p>
      <p class="text-sm leading-6 text-muted-foreground">
        <span class="font-medium text-foreground">To be completed.</span> Complete
        the terms for publishing, moderation, license compliance, and removal
        requests.
      </p>
    </div>
  </section>

  <section id="billing" aria-labelledby="billing-heading" class="scroll-mt-8 border-t pt-8">
    <h2 id="billing-heading" class="text-xl font-semibold text-balance">Subscriptions and AI billing</h2>
    <div class="mt-4 max-w-prose space-y-4 leading-7">
      <p>
        Stripe handles subscription checkout. Managed AI usage is billed
        separately from the plan price and compile allowances, using the model
        request cost reported by Cloudflare AI Gateway plus 20%. Failed or
        stopped assistant runs can still include billable requests, and usage
        reporting can finish after a run ends. Runs retain their original payer.
      </p>
      <p>
        AI spending limits apply per user and UTC calendar month. Setting the
        limit to $0 pauses new AI usage. A request can be refused before the
        displayed limit is reached when its estimated maximum cost does not fit
        the remaining budget.
      </p>
      <p class="text-sm leading-6 text-muted-foreground">
        <span class="font-medium text-foreground">To be completed.</span> Approve
        price and currency wording, renewal, cancellation, refunds, taxes, failed
        payments, plan changes, and the process for billing errors and disputes.
      </p>
    </div>
  </section>

  <section id="fair-use" aria-labelledby="fair-use-heading" class="scroll-mt-8 border-t pt-8">
    <h2 id="fair-use-heading" class="text-xl font-semibold text-balance">Fair use</h2>
    <div class="mt-4 max-w-prose space-y-4 leading-7">
      <p>
        Fair use applies to compilation on all plans. Compile timeouts and
        request rate limits depend on your plan. To keep Texfolia fast and
        available for everyone, sustained heavy compilation may be temporarily
        slowed or paused. You can try again after a short wait; access recovers
        automatically as recent activity decreases.
      </p>
    </div>
  </section>

  <section id="assistant" aria-labelledby="assistant-heading" class="scroll-mt-8 border-t pt-8">
    <h2 id="assistant-heading" class="text-xl font-semibold text-balance">Using the assistant</h2>
    <div class="mt-4 max-w-prose space-y-4 leading-7 [&_a]:underline [&_a]:underline-offset-4">
      <p>
        The assistant sends conversation context and project content read by its
        tools to the selected model service through Cloudflare AI Gateway. File
        edits are saved immediately and shared with collaborators. Chats are
        saved for each user and project. The{" "}
        <a href="/privacy">privacy template</a> describes the current data
        handling.
      </p>
      <p class="text-sm leading-6 text-muted-foreground">
        <span class="font-medium text-foreground">To be completed.</span> Set out
        responsibility for AI output, review of generated changes, applicable
        provider conditions, and any approved limitations.
      </p>
    </div>
  </section>

  <section id="exports-and-deletion" aria-labelledby="exports-and-deletion-heading" class="scroll-mt-8 border-t pt-8">
    <h2 id="exports-and-deletion-heading" class="text-xl font-semibold text-balance">Exports and deletion</h2>
    <div class="mt-4 max-w-prose space-y-4 leading-7 [&_a]:underline [&_a]:underline-offset-4">
      <p>
        Project export downloads a ZIP of current saved sources, with generated
        files optional when a build exists. Optional Git commits keep versions;
        pushing keeps a copy on the connected repository host. Project deletion
        removes access and starts server cleanup, with some work handled by
        background jobs. Account deletion is available through an email-confirmed
        flow in <a href={accountSettings}>account settings</a>.
      </p>
      <p class="text-sm leading-6 text-muted-foreground">
        <span class="font-medium text-foreground">To be completed.</span> Complete
        retention and deletion terms, including the handling of saved chats,
        templates, independent copies, and billing records.
      </p>
    </div>
  </section>

  <section id="termination" aria-labelledby="termination-heading" class="scroll-mt-8 border-t pt-8">
    <h2 id="termination-heading" class="text-xl font-semibold text-balance">Suspension and termination</h2>
    <div class="mt-4 max-w-prose space-y-4 leading-7">
      <p class="text-sm leading-6 text-muted-foreground">
        <span class="font-medium text-foreground">To be completed.</span> Define
        when access may be suspended or terminated, how users are notified, and
        how account closure affects subscriptions and access to content.
      </p>
    </div>
  </section>

  <section id="legal-terms" aria-labelledby="legal-terms-heading" class="scroll-mt-8 border-t pt-8">
    <h2 id="legal-terms-heading" class="text-xl font-semibold text-balance">Availability, liability, and disputes</h2>
    <div class="mt-4 max-w-prose space-y-4 leading-7">
      <p class="text-sm leading-6 text-muted-foreground">
        <span class="font-medium text-foreground">To be completed.</span> Add
        approved availability and warranty language, liability terms, governing
        law, and dispute handling. No jurisdiction or liability limit has been
        selected for this template.
      </p>
    </div>
  </section>

  <section id="terms-changes" aria-labelledby="terms-changes-heading" class="scroll-mt-8 border-t pt-8">
    <h2 id="terms-changes-heading" class="text-xl font-semibold text-balance">Changes and contact</h2>
    <div class="mt-4 max-w-prose space-y-4 leading-7">
      <p class="text-sm leading-6 text-muted-foreground">
        <span class="font-medium text-foreground">To be completed.</span> Explain
        how changes to the service and terms are communicated, and add a
        monitored support contact.
      </p>
    </div>
  </section>
</PolicyLayout>

---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";

interface Section {
  id: string;
  title: string;
}

interface Props {
  title: string;
  documentTitle: string;
  sections: Section[];
}

const { title, documentTitle, sections } = Astro.props;
---

<BaseLayout title={documentTitle} robots="noindex, nofollow">
  <div class="flex min-h-svh flex-col">
    <Header />
    <main
      id="main-content"
      class="mx-auto w-full max-w-3xl px-6 py-16 sm:py-24"
    >
      <h1 class="font-serif text-5xl tracking-tight text-balance sm:text-6xl">
        {title}
      </h1>
      <aside
        aria-labelledby="policy-template-notice"
        class="mt-8 space-y-3 border bg-muted p-5 sm:p-6"
      >
        <h2 id="policy-template-notice" class="text-lg font-semibold">
          Placeholder for review
        </h2>
        <p class="max-w-prose leading-7">
          This page is an unapproved template, not a final release policy.
          Product descriptions are draft copy. Sections marked "To be completed"
          still need final wording and approval.
        </p>
        <p class="text-sm font-medium">Effective date: Not set</p>
      </aside>
      <nav aria-label="On this page" class="mt-10">
        <h2 class="text-sm font-semibold">On this page</h2>
        <ul class="mt-3 grid gap-x-8 sm:grid-cols-2">
          {
            sections.map((section) => (
              <li>
                <a
                  href={`#${section.id}`}
                  class="inline-block py-2 text-sm underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-4"
                >
                  {section.title}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <div class="mt-10 space-y-10">
        <slot />
      </div>
      <nav
        aria-label="Policy pages"
        class="mt-12 flex flex-wrap gap-x-6 gap-y-4 border-t pt-8 text-sm [&_a]:underline [&_a]:underline-offset-4 [&_a:focus-visible]:outline-2 [&_a:focus-visible]:outline-offset-4"
      >
        <a href="/privacy">Privacy policy</a>
        <a href="/terms">Terms of service</a>
        <a href="/pricing">Plans and pricing</a>
      </nav>
    </main>
    <Footer />
  </div>
</BaseLayout>

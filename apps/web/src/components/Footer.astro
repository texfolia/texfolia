---
const year = new Date().getFullYear();
---

<footer class="mt-auto border-t">
  <div
    class="mx-auto flex max-w-7xl flex-col justify-between gap-6 px-6 py-10 text-sm sm:flex-row sm:items-center sm:px-8"
  >
    <div>
      <a href="/" class="font-serif text-2xl text-foreground">Texfolia.</a>
      <p class="mt-2 text-muted-foreground">A little more space to think.</p>
    </div>
    <nav
      aria-label="Footer"
      class="flex flex-wrap gap-x-6 gap-y-3 text-muted-foreground [&_a]:underline-offset-4 [&_a:hover]:text-foreground [&_a:hover]:underline [&_a:focus-visible]:outline-2 [&_a:focus-visible]:outline-offset-4"
    >
      <a href="/templates">Templates</a>
      <a href="/pricing">Pricing</a>
      <a href="/privacy">Privacy</a>
      <a href="/terms">Terms</a>
    </nav>
    <p class="text-xs text-muted-foreground">© {year} Texfolia</p>
  </div>
</footer>

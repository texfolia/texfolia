---
import { appPath } from "@/lib/urls";

const appHome = appPath("/projects");
const login = appPath("/login");
---

<header class="border-b bg-background">
  <a
    href="#main-content"
    class="sr-only z-50 bg-background p-3 focus:not-sr-only focus:absolute"
  >
    Skip to content
  </a>
  <div
    class="mx-auto flex max-w-7xl flex-wrap items-center gap-4 px-5 py-4 sm:h-20 sm:flex-nowrap sm:gap-10 sm:px-8 sm:py-0"
  >
    <a
      href="/"
      class="mr-auto font-serif text-3xl tracking-tight focus-visible:outline-2 focus-visible:outline-offset-4"
    >
      Texfolia<span aria-hidden="true" class="text-muted-foreground">.</span>
    </a>
    <nav
      aria-label="Main navigation"
      class="order-last flex w-full items-center justify-center gap-8 text-sm sm:order-0 sm:w-auto"
    >
      <a
        href="/templates"
        class="text-muted-foreground underline-offset-4 hover:text-foreground hover:underline focus-visible:outline-2 focus-visible:outline-offset-4"
      >
        Templates
      </a>
      <a
        href="/pricing"
        class="text-muted-foreground underline-offset-4 hover:text-foreground hover:underline focus-visible:outline-2 focus-visible:outline-offset-4"
      >
        Pricing
      </a>
    </nav>
    <a href={login} class="btn btn-outline">Sign in</a>
    <a href={appHome} class="btn btn-primary btn-lg">Open app</a>
  </div>
</header>

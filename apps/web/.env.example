BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Also used by auth:schema. Keep in sync with packages/db/.env.
DATABASE_URL=postgres://user:password@localhost:5432/db

# Local Hyperdrive connection; keep in sync with DATABASE_URL.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgres://user:password@localhost:5432/db

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Use the signing secret from: stripe listen --forward-to localhost:3000/api/auth/stripe/webhook
# Events are forwarded to /api/auth/stripe/webhook.
STRIPE_WEBHOOK_SECRET=
# Stripe recurring monthly price for the Pro plan ($15/month).
STRIPE_PRO_PRICE_ID=

VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# Comma-separated hostnames. Defaults to the hostname of BETTER_AUTH_URL.
TURNSTILE_HOSTNAMES=localhost

# Managed assistant. All inference uses this Cloudflare account/gateway.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_GATEWAY_ID=
# Token with Workers AI Read, AI Gateway Read, and AI Gateway Run permissions.
CLOUDFLARE_AI_API_TOKEN=
# Monthly USD metered price: $0.000000001 per unit (one nano-dollar).
STRIPE_AI_PRICE_ID=
STRIPE_AI_METER_EVENT_NAME=texfolia_ai_nanos

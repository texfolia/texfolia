+# Texfolia: what a replacement could use from Perl's double-quoted strings
+# (groups, case changes, and escapes), without evaluating it as Perl.
+sub expand_replacement {
+  my ($template, $groups) = @_;
+  my ($result, $case, $next) = ('', '', '');
+  while ($template =~ /\G(?:\\(?<case>[ULulEQ])|\\(?<escape>.)|\$(?:(?<group>[0-9]+|&)|\{(?<group>[0-9]+)\})|(?<text>.))/gcxms) {
+    my %part = %+;
+    if (defined(my $c = $part{case})) {
+      if ($c =~ /[ul]/) { $next = $c }
+      else { $case = $c eq 'E' ? '' : $c }
+      next;
+    }
+    my $text;
+    if (defined(my $g = $part{group})) { $text = $groups->[$g eq '&' ? 0 : $g] // '' }
+    elsif (defined(my $e = $part{escape})) { $text = {n => "\n", t => "\t", r => "\r"}->{$e} // $e }
+    else { $text = $part{text} }
+    $text = $case eq 'U' ? uc($text) : $case eq 'L' ? lc($text) : $case eq 'Q' ? quotemeta($text) : $text;
+    if ($next and length($text)) {
+      $text = $next eq 'u' ? ucfirst($text) : lcfirst($text);
+      $next = '';
+    }
+    $result .= $text;
+  }
+  return $result;
+}

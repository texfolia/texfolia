{
  "name": "compiler",
  "private": true,
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "cf:typegen": "wrangler types --include-runtime=false --strict-vars=false && oxfmt worker-configuration.d.ts",
    "deploy": "wrangler deploy --env production",
    "dev": "bun run engine:build && bun --watch src/index.ts",
    "engine:build": "docker build --platform linux/amd64 -t texfolia-latex-engine:local -f Dockerfile ../..",
    "format": "gofmt -w engine",
    "format:check": "bun run scripts/check-go-format.ts",
    "lint": "cd engine && go vet ./...",
    "start": "bun run engine:build && bun run src/index.ts",
    "test": "bun test && cd engine && go test -race ./...",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.0.25",
    "@texfolia/contracts": "workspace:*",
    "effect": "^4.1.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261031.1",
    "@texfolia/db": "workspace:*",
    "@texfolia/tsconfig": "workspace:*",
    "@types/bun": "^1.4.4",
    "typescript": "^6.0.2",
    "wrangler": "^4.156.1",
    "zod": "^4.6.7"
  }
}

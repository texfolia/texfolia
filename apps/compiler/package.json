{
  "name": "compiler",
  "private": true,
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "build": "docker compose -f ../../compose.yaml build compiler latex-engine",
    "cf:typegen": "wrangler types --include-runtime=false --strict-vars=false && oxfmt worker-configuration.d.ts",
    "deploy": "wrangler deploy",
    "dev": "docker compose -f ../../compose.yaml up --no-build --no-recreate --attach-dependencies compiler db",
    "dev:setup": "docker compose -f ../../compose.yaml up --no-build --wait compiler",
    "dev:stop": "docker compose -f ../../compose.yaml stop",
    "dev:workers": "wrangler dev --port 8787 --compatibility-date 2026-10-30",
    "format": "gofmt -w engine",
    "format:check": "bun run scripts/check-go-format.ts",
    "lint": "cd engine && go vet ./...",
    "ready:workers": "bun run scripts/wait-ready.ts",
    "smoke": "bun run test/coordinator-smoke.ts",
    "smoke:legacy": "bun run test/smoke.ts",
    "smoke:workers": "COMPILER_URL=http://127.0.0.1:8787 bun run test/coordinator-smoke.ts",
    "start": "bun run src/index.ts",
    "test": "bun test && cd engine && go test -race ./...",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.0.25",
    "hono": "^4.13.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@texfolia/typescript-config": "workspace:*",
    "@types/bun": "latest",
    "typescript": "^6.0.2",
    "wrangler": "^4.70.0"
  }
}

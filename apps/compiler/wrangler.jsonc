{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "texfolia-compiler",
  "main": "worker.ts",
  "compatibility_date": "2026-10-31",
  "containers": [
    {
      "class_name": "TectonicContainer",
      "image": "./Dockerfile",
      "image_build_context": "../..",
      "max_instances": 1,
      "instance_type": "basic",
    },
  ],
  "durable_objects": {
    "bindings": [{ "name": "COMPILER", "class_name": "TectonicContainer" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TectonicContainer"] }],
  "r2_buckets": [{ "binding": "PDFS", "bucket_name": "texfolia-compilations" }],
  "queues": {
    "producers": [{ "binding": "COMPILE_QUEUE", "queue": "texfolia-compile" }],
    "consumers": [
      {
        "queue": "texfolia-compile",
        "max_batch_size": 1,
        "max_batch_timeout": 0,
        "max_concurrency": 1,
        "max_retries": 3,
      },
    ],
  },
  "ratelimits": [
    {
      "name": "COMPILE_LIMIT",
      "namespace_id": "208",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true },
}

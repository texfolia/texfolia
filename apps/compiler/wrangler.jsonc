{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "texfolia-compiler-local",
  "main": "worker.ts",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "compatibility_date": "2026-10-31",
  // Stops a compile when its caller disconnects without cancelling it.
  "compatibility_flags": ["enable_request_signal"],
  "containers": [
    {
      "class_name": "TectonicContainer",
      "image": "./Dockerfile",
      "image_build_context": "../..",
      "max_instances": 20,
      "instance_type": "basic",
    },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "COMPILER", "class_name": "TectonicContainer" },
      { "name": "POOL", "class_name": "PoolManager" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TectonicContainer"] },
    { "tag": "v2", "new_sqlite_classes": ["ProjectCoordinator"] },
    { "tag": "v3", "new_sqlite_classes": ["PoolManager"] },
    { "tag": "v4", "new_sqlite_classes": ["UserCompileUsage"] },
    // Build history and fair use moved to apps/app.
    {
      "tag": "v5",
      "deleted_classes": ["ProjectCoordinator", "UserCompileUsage"],
    },
  ],
  "vars": {
    // Autoscaling. POOL_MAX_INSTANCES must not exceed max_instances above.
    // Raise POOL_CONCURRENCY only with a larger instance_type.
    "POOL_MIN_WARM": "0",
    "POOL_MAX_INSTANCES": "20",
    "POOL_CONCURRENCY": "1",
    "POOL_IDLE_MS": "600000",
    "POOL_MAX_QUEUED": "100",
  },
  // Explicitly empty so deploys remove the retired legacy recovery cron.
  "triggers": { "crons": [] },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 },
  },
  "env": {
    "production": {
      "name": "texfolia-compiler",
      "containers": [
        {
          "name": "texfolia-compiler-tectoniccontainer",
          "class_name": "TectonicContainer",
          "image": "./Dockerfile",
          "image_build_context": "../..",
          "max_instances": 20,
          "instance_type": "basic",
        },
      ],
      "durable_objects": {
        "bindings": [
          { "name": "COMPILER", "class_name": "TectonicContainer" },
          { "name": "POOL", "class_name": "PoolManager" },
        ],
      },
      "vars": {
        "POOL_MIN_WARM": "0",
        "POOL_MAX_INSTANCES": "20",
        "POOL_CONCURRENCY": "1",
        "POOL_IDLE_MS": "600000",
        "POOL_MAX_QUEUED": "100",
      },
    },
  },
}

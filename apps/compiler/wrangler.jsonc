{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "texfolia-compiler",
  "main": "worker.ts",
  "compatibility_date": "2026-10-31",
  "containers": [{
    "class_name": "TectonicContainer",
    "image": "./Dockerfile",
    "max_instances": 1,
    "instance_type": "basic"
  }],
  "durable_objects": { "bindings": [{ "name": "COMPILER", "class_name": "TectonicContainer" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TectonicContainer"] }],
  "r2_buckets": [{ "binding": "PDFS", "bucket_name": "texfolia-compilations" }],
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true }
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "texfolia-app-local",
  // Aligned with apps/compiler/wrangler.jsonc. Workers enables nodejs_compat
  // by default from 2026-08-04 onwards; kept explicit here while compiler
  // relies on the runtime default.
  "compatibility_date": "2026-10-31",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/worker.ts",
  "r2_buckets": [
    {
      "binding": "SOURCES",
      "bucket_name": "texfolia-sources-local",
      "remote": false,
    },
    {
      "binding": "BUILD_ARTIFACTS",
      "bucket_name": "texfolia-compilations-local",
      "remote": false,
    },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "COLLABORATION", "class_name": "ProjectCollaboration" },
      { "name": "BUILDS", "class_name": "ProjectBuilds" },
      { "name": "COMPILE_USAGE", "class_name": "CompileUsage" },
    ],
  },
  "migrations": [
    {
      "tag": "v1-collaboration",
      "new_sqlite_classes": ["ProjectCollaboration"],
    },
    {
      "tag": "v2-builds",
      "new_sqlite_classes": ["ProjectBuilds", "CompileUsage"],
    },
  ],
  // Makes the template gallery's thumbnails.
  "images": { "binding": "IMAGES", "remote": false },
  // Builds the direct path could not run, by plan, and delayed cleanup.
  "queues": {
    "producers": [
      {
        "binding": "COMPILE_PRO",
        "queue": "compile-pro-local",
        "remote": false,
      },
      {
        "binding": "COMPILE_FREE",
        "queue": "compile-free-local",
        "remote": false,
      },
      { "binding": "BACKGROUND", "queue": "background-local", "remote": false },
    ],
    "consumers": [
      {
        "queue": "compile-pro-local",
        "max_batch_size": 1,
        "max_batch_timeout": 0,
        "max_concurrency": 4,
        "max_retries": 1,
        "dead_letter_queue": "compile-dlq-local",
      },
      {
        "queue": "compile-free-local",
        "max_batch_size": 1,
        "max_batch_timeout": 0,
        "max_concurrency": 1,
        "max_retries": 1,
        "dead_letter_queue": "compile-dlq-local",
      },
      {
        "queue": "compile-dlq-local",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_concurrency": 2,
      },
      {
        "queue": "background-local",
        "max_batch_size": 20,
        "max_batch_timeout": 5,
        "max_concurrency": 1,
      },
    ],
  },
  // Per-user budget for citation metadata lookups (Crossref, DataCite, Open
  // Library), so one account cannot exhaust the shared upstream rate limits.
  "ratelimits": [
    {
      "name": "REFERENCE_LOOKUPS",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 },
    },
    // Free compile submissions per user.
    {
      "name": "COMPILE_LIMIT",
      "namespace_id": "244",
      "simple": { "limit": 2, "period": 10 },
    },
  ],
  "triggers": { "crons": ["17 * * * *", "41 3 * * *", "* * * * *"] },
  "services": [
    {
      "binding": "COMPILER",
      "service": "texfolia-compiler-local",
      "remote": false,
    },
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 },
  },
  "send_email": [
    {
      "name": "EMAIL",
    },
  ],
  "vars": {
    "TEMPLATE_REVIEWER_IDS": "",
    "EMAIL_FROM": "noreply@texfolia.com",
    "TURNSTILE_HOSTNAMES": "localhost",
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "<local-only; configure production before deploying>",
      "localConnectionString": "postgres://user:password@localhost:5432/db",
      "remote": false,
    },
  ],
  "env": {
    "production": {
      "name": "texfolia-app",
      "r2_buckets": [
        { "binding": "SOURCES", "bucket_name": "texfolia-sources" },
        {
          "binding": "BUILD_ARTIFACTS",
          "bucket_name": "texfolia-compilations",
        },
      ],
      "images": { "binding": "IMAGES" },
      "durable_objects": {
        "bindings": [
          { "name": "COLLABORATION", "class_name": "ProjectCollaboration" },
          { "name": "BUILDS", "class_name": "ProjectBuilds" },
          { "name": "COMPILE_USAGE", "class_name": "CompileUsage" },
        ],
      },
      "queues": {
        "producers": [
          { "binding": "COMPILE_PRO", "queue": "compile-pro" },
          { "binding": "COMPILE_FREE", "queue": "compile-free" },
          { "binding": "BACKGROUND", "queue": "background" },
        ],
        "consumers": [
          {
            "queue": "compile-pro",
            "max_batch_size": 1,
            "max_batch_timeout": 0,
            "max_concurrency": 4,
            "max_retries": 1,
            "dead_letter_queue": "compile-dlq",
          },
          {
            "queue": "compile-free",
            "max_batch_size": 1,
            "max_batch_timeout": 0,
            "max_concurrency": 1,
            "max_retries": 1,
            "dead_letter_queue": "compile-dlq",
          },
          {
            "queue": "compile-dlq",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_concurrency": 2,
          },
          {
            "queue": "background",
            "max_batch_size": 20,
            "max_batch_timeout": 5,
            "max_concurrency": 1,
          },
        ],
      },
      "hyperdrive": [
        { "binding": "HYPERDRIVE", "id": "<production hyperdrive id>" },
      ],
      "services": [{ "binding": "COMPILER", "service": "texfolia-compiler" }],
      "ratelimits": [
        {
          "name": "REFERENCE_LOOKUPS",
          "namespace_id": "1001",
          "simple": { "limit": 30, "period": 60 },
        },
        {
          "name": "COMPILE_LIMIT",
          "namespace_id": "243",
          "simple": { "limit": 2, "period": 10 },
        },
      ],
      "send_email": [{ "name": "EMAIL" }],
      "vars": {
        "TEMPLATE_REVIEWER_IDS": "",
        "EMAIL_FROM": "noreply@texfolia.com",
        "TURNSTILE_HOSTNAMES": "app.texfolia.com,texfolia.com,www.texfolia.com",
      },
    },
  },
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "texfolia-app-local",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/worker.ts",
  "r2_buckets": [
    {
      "binding": "SOURCES",
      "bucket_name": "texfolia-sources-local",
      "remote": false,
    },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "COLLABORATION", "class_name": "ProjectCollaboration" },
    ],
  },
  "migrations": [
    {
      "tag": "v1-collaboration",
      "new_sqlite_classes": ["ProjectCollaboration"],
    },
  ],
  // Per-user budget for citation metadata lookups (Crossref, DataCite, Open
  // Library), so one account cannot exhaust the shared upstream rate limits.
  "ratelimits": [
    {
      "name": "REFERENCE_LOOKUPS",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 },
    },
  ],
  "triggers": { "crons": ["17 * * * *", "41 3 * * *", "* * * * *"] },
  "services": [
    {
      "binding": "COMPILER",
      "service": "texfolia-compiler-local",
      "remote": false,
    },
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 },
  },
  "send_email": [
    {
      "name": "EMAIL",
    },
  ],
  "vars": {
    "TEMPLATE_REVIEWER_IDS": "",
    "EMAIL_FROM": "noreply@texfolia.com",
    "TURNSTILE_HOSTNAMES": "localhost",
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "<local-only; configure production before deploying>",
      "localConnectionString": "postgres://user:password@localhost:5432/db",
      "remote": false,
    },
  ],
  "env": {
    "production": {
      "name": "texfolia-app",
      "r2_buckets": [
        { "binding": "SOURCES", "bucket_name": "texfolia-sources" },
      ],
      "durable_objects": {
        "bindings": [
          { "name": "COLLABORATION", "class_name": "ProjectCollaboration" },
        ],
      },
      "hyperdrive": [
        { "binding": "HYPERDRIVE", "id": "<production hyperdrive id>" },
      ],
      "services": [{ "binding": "COMPILER", "service": "texfolia-compiler" }],
      "ratelimits": [
        {
          "name": "REFERENCE_LOOKUPS",
          "namespace_id": "1001",
          "simple": { "limit": 30, "period": 60 },
        },
      ],
      "send_email": [{ "name": "EMAIL" }],
      "vars": {
        "TEMPLATE_REVIEWER_IDS": "",
        "EMAIL_FROM": "noreply@texfolia.com",
        "TURNSTILE_HOSTNAMES": "app.texfolia.com,texfolia.com,www.texfolia.com",
      },
    },
  },
}

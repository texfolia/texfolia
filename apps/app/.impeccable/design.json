    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Explicit dialog actions use the existing Nova primary variant.",
      "html": "<button class=\"ds-primary\">Create file</button>",
      "css": ".ds-primary{font-family:var(--font-sans);display:inline-flex;align-items:center;justify-content:center;gap:6px;height:32px;padding:0 10px;border:1px solid transparent;border-radius:var(--radius);font-size:14px;line-height:20px;font-weight:500;white-space:nowrap;transition:background-color 150ms,box-shadow 150ms;}.ds-primary{background:var(--primary);color:var(--primary-foreground)}.ds-primary:hover{background:color-mix(in oklab,var(--primary) 80%,transparent)}.ds-primary:focus-visible{outline:none;border-color:var(--ring);box-shadow:0 0 0 3px color-mix(in oklab,var(--ring) 50%,transparent);}.ds-primary:active{transform:translateY(1px)}.ds-primary:disabled{pointer-events:none;opacity:.5}"
    },
    {
      "name": "Small ghost tool",
      "kind": "button",
      "refersTo": "button-ghost-xs",
      "description": "Compact panel and status actions retain Nova rounding.",
      "html": "<button class=\"ds-ghost\">Problems (0)</button>",
      "css": ".ds-ghost{font-family:var(--font-sans);display:inline-flex;align-items:center;justify-content:center;gap:6px;height:32px;padding:0 10px;border:1px solid transparent;border-radius:var(--radius);font-size:14px;line-height:20px;font-weight:500;white-space:nowrap;transition:background-color 150ms,box-shadow 150ms;}.ds-ghost{height:24px;gap:4px;padding:0 8px;border-radius:min(calc(var(--radius) * 0.8),10px);background:transparent;color:var(--foreground);font-size:12px;line-height:16px}.ds-ghost:hover,.ds-ghost[aria-expanded=\"true\"]{background:var(--muted);color:var(--foreground)}:host-context(.dark) .ds-ghost:hover{background:color-mix(in oklab,var(--muted) 50%,transparent)}.ds-ghost:focus-visible{outline:none;border-color:var(--ring);box-shadow:0 0 0 3px color-mix(in oklab,var(--ring) 50%,transparent);}.ds-ghost:active{transform:translateY(1px)}.ds-ghost:disabled{pointer-events:none;opacity:.5}"
    },
    {
      "name": "Outline button",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Secondary dialog actions reuse the outline variant.",
      "html": "<button class=\"ds-outline\">Cancel</button>",
      "css": ".ds-outline{font-family:var(--font-sans);display:inline-flex;align-items:center;justify-content:center;gap:6px;height:32px;padding:0 10px;border:1px solid transparent;border-radius:var(--radius);font-size:14px;line-height:20px;font-weight:500;white-space:nowrap;transition:background-color 150ms,box-shadow 150ms;}.ds-outline{border-color:var(--border);background:var(--background);color:var(--foreground)}.ds-outline:hover{background:var(--muted)}:host-context(.dark) .ds-outline{border-color:var(--input);background:color-mix(in oklab,var(--input) 30%,transparent)}:host-context(.dark) .ds-outline:hover{background:color-mix(in oklab,var(--input) 50%,transparent)}.ds-outline:focus-visible{outline:none;border-color:var(--ring);box-shadow:0 0 0 3px color-mix(in oklab,var(--ring) 50%,transparent);}.ds-outline:active{transform:translateY(1px)}.ds-outline:disabled{pointer-events:none;opacity:.5}"
    },
    {
      "name": "Input",
      "kind": "input",
      "refersTo": "input",
      "description": "Existing Nova text fields keep their responsive type size and focus state.",
      "html": "<input class=\"ds-input\" aria-label=\"File name\" placeholder=\"File name\">",
      "css": ".ds-input{font-family:var(--font-sans);height:32px;width:100%;min-width:0;border:1px solid var(--input);border-radius:var(--radius);padding:4px 10px;background:transparent;color:var(--foreground);font-size:16px;line-height:24px;transition:color 150ms,background-color 150ms,border-color 150ms}.ds-input::placeholder{color:var(--muted-foreground)}@media(min-width:48rem){.ds-input{font-size:14px;line-height:20px}}:host-context(.dark) .ds-input{background:color-mix(in oklab,var(--input) 30%,transparent)}.ds-input:focus-visible{outline:none;border-color:var(--ring);box-shadow:0 0 0 3px color-mix(in oklab,var(--ring) 50%,transparent);}.ds-input:disabled{pointer-events:none;opacity:.5;background:color-mix(in oklab,var(--input) 50%,transparent)}.ds-input[aria-invalid=\"true\"]{border-color:var(--destructive);box-shadow:0 0 0 3px color-mix(in oklab,var(--destructive) 20%,transparent)}"
    },
    {
      "name": "Nova card",
      "kind": "card",
      "refersTo": "card",
      "description": "The existing library container; dock panels remain flat.",
      "html": "<section class=\"ds-card\"><div class=\"ds-card-content\">Card content</div></section>",
      "css": ".ds-card{font-family:var(--font-sans);display:flex;flex-direction:column;gap:16px;overflow:hidden;border-radius:calc(var(--radius) * 1.4);background:var(--card);color:var(--card-foreground);padding:16px 0;font-size:14px;line-height:20px;box-shadow:0 0 0 1px color-mix(in oklab,var(--foreground) 10%,transparent)}.ds-card-content{padding:0 16px}"
    },
    {
      "name": "Workspace menubar",
      "kind": "nav",
      "description": "File, Edit, and View use Nova menu triggers within the workspace header.",
      "html": "<nav class=\"ds-menubar\" aria-label=\"Workspace menu\"><button class=\"ds-menu-trigger\" aria-haspopup=\"menu\">File</button><button class=\"ds-menu-trigger\" aria-haspopup=\"menu\">Edit</button><button class=\"ds-menu-trigger\" aria-haspopup=\"menu\">View</button></nav>",
      "css": ".ds-menubar{font-family:var(--font-sans);display:flex;align-items:center;gap:2px;height:32px;padding:0;background:transparent;color:var(--activity-foreground)}.ds-menu-trigger{font:inherit;font-size:14px;line-height:20px;font-weight:500;border:0;border-radius:calc(var(--radius) * 0.6);padding:2px 6px;background:transparent;color:inherit}.ds-menu-trigger:hover,.ds-menu-trigger[aria-expanded=\"true\"]{background:var(--muted)}.ds-menu-trigger:focus-visible{outline:2px solid var(--ring);outline-offset:2px}"
    },
    {
      "name": "Files row",
      "kind": "nav",
      "refersTo": "file-row",
      "description": "Nova SidebarMenuButton with the Files-only square, padding-free 24px treatment.",
      "html": "<ul class=\"ds-files\"><li><button class=\"ds-file-row\" aria-current=\"true\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M14 3v4a1 1 0 0 0 1 1h4\"/><path d=\"M17 21h-10a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2z\"/></svg><span>main.tex</span></button></li></ul>",
      "css": ".ds-files{font-family:var(--font-sans);display:flex;flex-direction:column;gap:0;margin:0;padding:0;list-style:none;background:var(--sidebar);color:var(--sidebar-foreground)}.ds-file-row{font:inherit;font-size:12px;line-height:16px;display:flex;align-items:center;gap:8px;width:100%;height:24px;margin:0;border:0;border-radius:0;padding:0 0 0 14px;text-align:left;background:transparent;color:inherit;overflow:hidden;outline:none}.ds-file-row svg{flex-shrink:0}.ds-file-row span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.ds-file-row:hover,.ds-file-row:active,.ds-file-row[aria-current=\"true\"]{background:var(--sidebar-accent);color:var(--sidebar-accent-foreground)}.ds-file-row[aria-current=\"true\"]{font-weight:500}.ds-file-row:focus-visible{box-shadow:0 0 0 2px var(--sidebar-ring)}.ds-file-row:disabled{pointer-events:none;opacity:.5}"
    },
    {
      "name": "Dock file tab",
      "kind": "custom",
      "refersTo": "dock-tab-active",
      "description": "Theme-bound Dockview tab with an italic preview title.",
      "html": "<div class=\"ds-tabs\"><button class=\"ds-tab ds-tab-preview\" aria-label=\"main.tex preview\">main.tex</button></div>",
      "css": ".ds-tabs{font-family:var(--font-sans);height:35px;background:var(--tab-header);color:var(--tab-inactive-foreground)}.ds-tab{font:inherit;font-size:13px;height:35px;padding:0 8px;border:0;border-right:1px solid var(--tab-border);background:var(--tab-active-background);color:var(--tab-active-foreground)}.ds-tab-preview{font-style:italic}.ds-tab:focus-visible{outline:1px solid var(--ring);outline-offset:-1px}"
    }

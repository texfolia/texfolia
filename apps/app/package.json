{
  "name": "app",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "auth:schema": "bunx auth generate --output ../../packages/db/src/auth-schema.ts --config ./auth.config.ts --yes",
    "billing:setup": "bun run scripts/setup-billing.ts",
    "build": "bun run latex:assets && bun run spelling:assets && CLOUDFLARE_ENV=production vite build",
    "cf:typegen": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler types --strict-vars=false",
    "deploy": "wrangler deploy --env production",
    "dev": "bun run scripts/migrate-local-storage.ts && bun run latex:assets && bun run spelling:assets && vite dev --port 3000 --strictPort",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "generate-routes": "bun run scripts/generate-routes.ts",
    "latex:assets": "wasm-latex-tools copy-assets ./public/core",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "preview": "vite preview",
    "spelling:assets": "bun run scripts/copy-dictionaries.ts",
    "test": "bun test",
    "test:ai-assistant": "bun run test/ai-assistant.ts",
    "test:ai-billing": "bun run test/ai-billing.ts",
    "test:billing": "bun run test/billing.ts",
    "test:collaboration": "bun run test/collaboration.ts",
    "test:collaboration-cache": "bun run test/collaboration-cache.ts",
    "test:compile-route": "bun run test/compile-route.ts",
    "test:editor-keymaps": "bun run test/editor-keymaps.ts",
    "test:git": "bun run test/git-integration.ts",
    "test:login": "bun run test/login.ts",
    "test:pricing": "bun run build && bun run test/pricing.ts",
    "test:production-assets": "bun run test/production-assets.ts",
    "test:projects": "bun run test/projects.ts",
    "test:settings": "bun run test/settings.ts",
    "test:spelling": "bun run test/spelling.ts",
    "test:synctex": "bun run test/synctex.ts",
    "test:template-lifecycle": "bun run build && bun run test/template-lifecycle.ts",
    "test:template-lifecycle:prebuilt": "bun run test/template-lifecycle.ts",
    "test:themes": "bun run test/theme-preview.ts",
    "test:ui": "bun run build && bun run test/ui-overhaul.ts",
    "test:workspace-metadata": "bun run build && bun run test/workspace-metadata.ts",
    "test:workspace-metadata:prebuilt": "bun run test/workspace-metadata.ts",
    "test:workspace-upload": "bun run test/workspace-upload.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@better-auth/drizzle-adapter": "1.7.15",
    "@better-auth/stripe": "^1.7.15",
    "@codemirror/autocomplete": "^6.20.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@tabler/icons-react": "^3.50.0",
    "@tanstack/ai": "^1.4.0",
    "@tanstack/ai-cloudflare": "^1.2.0",
    "@tanstack/ai-react": "^1.0.2",
    "@tanstack/markdown": "^1.2.0",
    "@tanstack/react-db": "^1.0.0-rc.1.4",
    "@tanstack/react-form-start": "^1.33.5",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "@tanstack/react-table": "^9.3.1",
    "@texfolia/auth": "workspace:*",
    "@texfolia/billing": "workspace:*",
    "@texfolia/collaboration": "workspace:*",
    "@texfolia/compile": "workspace:*",
    "@texfolia/contracts": "workspace:*",
    "@texfolia/db": "workspace:*",
    "@texfolia/editor": "workspace:*",
    "@texfolia/git": "workspace:*",
    "@texfolia/projects": "workspace:*",
    "@texfolia/storage": "workspace:*",
    "@texfolia/ui": "workspace:*",
    "@uiw/react-codemirror": "^4.25.12",
    "better-auth": "1.7.15",
    "cn": "^0.5.1",
    "dictionary-de": "3.0.0",
    "dictionary-en": "4.0.0",
    "dictionary-en-gb": "3.0.0",
    "dictionary-es": "4.0.0",
    "dictionary-fr": "3.0.0",
    "dockview-react": "^8.8.3",
    "drizzle-orm": "^1.0.0-rc.5",
    "input-otp": "^1.5.0",
    "pdfjs-dist": "6.3.289",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-pdf": "^11.0.0",
    "react-turnstile": "^1.1.5",
    "stripe": "^23.1.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "wasm-latex-tools": "^0.2.0",
    "y-codemirror.next": "^0.3.6",
    "yaml": "^2.8.3",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.26.0",
    "@cloudflare/workers-types": "5.20261031.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/devtools-vite": "0.8.6",
    "@tanstack/react-devtools": "0.10.14",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/router-cli": "^1.132.0",
    "@texfolia/config": "workspace:*",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@uiw/codemirror-themes-all": "^4.25.12",
    "@vitejs/plugin-react": "^6.0.1",
    "esbuild": "0.25.12",
    "miniflare": "5.20261023.3-beta",
    "playwright": "^1.61.0",
    "shadcn": "^4.23.0",
    "typescript": "^6.0.2",
    "vite": "^8.3.6",
    "wrangler": "^4.70.0",
    "y-indexeddb": "^9.0.12"
  }
}

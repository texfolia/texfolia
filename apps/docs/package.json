{
  "name": "docs",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "deploy": "wrangler deploy --env production",
    "dev": "next dev --port 4322",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "postinstall": "fumadocs-mdx",
    "preview": "wrangler dev --port 4322",
    "test": "bun run scripts/smoke.ts",
    "typecheck": "fumadocs-mdx && next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "fumadocs-core": "^16.19.7",
    "fumadocs-mdx": "^15.6.4",
    "fumadocs-ui": "^16.19.7",
    "lucide-react": "^1.83.0",
    "next": "^16.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@texfolia/tsconfig": "workspace:*",
    "@types/mdx": "^2.0.13",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "postcss": "8.5.33",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.2",
    "wrangler": "^4.156.1"
  }
}

{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalDependencies": ["packages/typescript-config/**/*.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["*"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "passThroughEnv": ["GOCACHE", "GOMODCACHE", "GOPATH", "GOFLAGS"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "compiler#build": {
      "cache": false,
      "passThroughEnv": ["DOCKER_*", "COMPOSE_*"]
    },
    "//#db:setup": {
      "cache": false,
      "passThroughEnv": ["DOCKER_*", "COMPOSE_*"]
    },
    "compiler#dev:setup": {
      "dependsOn": ["compiler#build", "//#db:setup"],
      "cache": false,
      "passThroughEnv": ["DOCKER_*", "COMPOSE_*"]
    },
    "compiler#dev": {
      "dependsOn": ["compiler#dev:setup"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["*"]
    },
    "web#dev": {
      "dependsOn": ["compiler#dev:setup", "@texfolia/db#dev:setup"],
      "with": ["compiler#dev"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["*"]
    },
    "dev:workers": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["*"]
    },
    "web#dev:workers": {
      "dependsOn": ["@texfolia/db#dev:setup", "compiler#ready:workers"],
      "with": ["compiler#dev:workers"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["*"]
    },
    "ready:workers": {
      "cache": false
    },
    "dev:stop": {
      "cache": false,
      "passThroughEnv": ["DOCKER_*", "COMPOSE_*"]
    },
    "db:push": {
      "cache": false,
      "passThroughEnv": ["DATABASE_URL"]
    },
    "smoke": {
      "cache": false,
      "passThroughEnv": ["COMPILER_URL"]
    },
    "smoke:workers": {
      "cache": false
    },
    "start": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["*"]
    },
    "preview": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["build"],
      "passThroughEnv": ["*"]
    },
    "cf:typegen": {
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "auth:schema": {
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "deploy": {
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "web#deploy": {
      "dependsOn": ["web#build", "compiler#deploy"],
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "lint": {
      "dependsOn": ["//#lint:repo"],
      "outputs": [],
      "passThroughEnv": ["GOCACHE", "GOMODCACHE", "GOPATH", "GOFLAGS"]
    },
    "//#lint:repo": {
      "cache": false
    },
    "format": {
      "dependsOn": ["//#format:repo"],
      "cache": false
    },
    "//#format:repo": {
      "cache": false
    },
    "format:check": {
      "dependsOn": ["//#format:check:repo"],
      "outputs": []
    },
    "//#format:check:repo": {
      "cache": false
    },
    "compiler#start": {
      "dependsOn": ["compiler#build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["*"]
    },
    "smoke:legacy": {
      "cache": false,
      "passThroughEnv": ["COMPILER_URL"]
    },
    "web#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".wrangler/deploy/**"],
      "env": ["CLOUDFLARE_ENV", "VITE_*"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    },
    "generate-routes": {
      "cache": false
    },
    "latex:assets": {
      "cache": false
    },
    "@texfolia/db#dev:setup": {
      "dependsOn": ["//#db:setup"],
      "cache": false,
      "passThroughEnv": ["DATABASE_URL"]
    },
    "db:generate": {
      "cache": false,
      "passThroughEnv": ["DATABASE_URL"]
    },
    "db:migrate": {
      "cache": false,
      "passThroughEnv": ["DATABASE_URL"]
    },
    "test:integration": {
      "cache": false,
      "passThroughEnv": ["INTEGRATION_DATABASE_URL"]
    },
    "stripe:listen": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["STRIPE_*"]
    },
    "build:production": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".wrangler/deploy/**"]
    },
    "build:staging": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".wrangler/deploy/**"]
    }
  }
}

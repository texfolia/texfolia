{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalDependencies": ["packages/typescript-config/**/*.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["*"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "passThroughEnv": ["GOCACHE", "GOMODCACHE", "GOPATH", "GOFLAGS"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "compiler#build": {
      "cache": false,
      "passThroughEnv": ["DOCKER_*"]
    },
    "compiler#dev": {
      "dependsOn": ["compiler#build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["*"]
    },
    "web#dev": {
      "dependsOn": ["@texfolia/db#db:start"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["*"]
    },
    "db:push": {
      "cache": false,
      "passThroughEnv": ["DATABASE_URL"]
    },
    "start": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["*"]
    },
    "preview": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["build"],
      "passThroughEnv": ["*"]
    },
    "cf:typegen": {
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "auth:schema": {
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "deploy": {
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "web#deploy": {
      "dependsOn": ["web#build", "compiler#deploy"],
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "lint": {
      "outputs": [],
      "passThroughEnv": ["GOCACHE", "GOMODCACHE", "GOPATH", "GOFLAGS"]
    },
    "format": {
      "cache": false
    },
    "format:check": {
      "outputs": []
    },
    "compiler#start": {
      "dependsOn": ["compiler#build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["*"]
    },
    "web#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".wrangler/deploy/**"],
      "env": ["CLOUDFLARE_ENV", "VITE_*"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    },
    "generate-routes": {
      "cache": false
    },
    "latex:assets": {
      "cache": false
    },
    "db:generate": {
      "cache": false,
      "passThroughEnv": ["DATABASE_URL"]
    },
    "db:migrate": {
      "cache": false,
      "passThroughEnv": ["DATABASE_URL"]
    },
    "db:start": {
      "cache": false,
      "passThroughEnv": ["DOCKER_*", "COMPOSE_*"]
    },
    "db:seed": {
      "cache": false,
      "passThroughEnv": ["*"]
    }
  }
}

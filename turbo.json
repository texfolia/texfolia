{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "envMode": "loose",
  "cacheMaxSize": "200MB",
  "globalDependencies": [
    "tsconfig.json",
    "packages/tsconfig/*.json",
    "scripts/local-environment.mts",
    ".oxlintrc.json",
    ".oxfmtrc.json",
    ".github/workflows/**",
    ".github/actions/**"
  ],
  "globalEnv": ["CI", "NODE_ENV", "CI_BUN_VERSION", "CI_GO_VERSION"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": ["CLOUDFLARE_ENV", "VITE_*", "PUBLIC_*"],
      "outputs": ["dist/**"]
    },
    "app#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": ["CLOUDFLARE_ENV", "VITE_*", "PUBLIC_*"],
      "outputs": ["dist/**", ".wrangler/deploy/**", "public/dictionaries/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    },
    "typecheck": {
      "dependsOn": ["^build", "^typecheck"]
    },
    "app#typecheck": {
      "dependsOn": ["^build", "^typecheck"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/compiler/src/**",
        "$TURBO_ROOT$/apps/compiler/scripts/engine-client.ts"
      ]
    },
    "lint": {},
    "format": {
      "cache": false
    },
    "format:check": {},
    "cf:typegen": {
      "cache": false
    },
    "deploy": {
      "dependsOn": ["build"],
      "cache": false
    },
    "app#deploy": {
      "dependsOn": ["build", "compiler#deploy"],
      "cache": false
    }
  }
}

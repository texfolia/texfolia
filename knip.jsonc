{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "ignoreBinaries": ["go", "gofmt"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"],
      "project": ["scripts/*.mjs"],
      // Referenced by the root tsconfig's extends field.
      "ignoreDependencies": ["@texfolia/typescript-config"],
    },
    "apps/web": {
      "entry": [
        "auth.config.ts",
        "test/**/*.{ts,tsx}",
        // shadcn's components.json resolves this alias when adding components.
        "src/lib/utils.ts",
      ],
      "project": [
        "src/**/*.{ts,tsx,css}",
        "test/**/*.{ts,tsx}",
        "*.ts",
        "scripts/*.ts",
      ],
    },
    "apps/compiler": {
      "entry": ["scripts/*.ts", "test/**/*.ts"],
      "project": ["src/**/*.ts", "scripts/*.ts", "test/**/*.ts", "*.ts"],
    },
  },
}

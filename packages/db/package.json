{
  "name": "@texfolia/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./template-starters": "./src/template-starters.ts",
    "./seed-templates": "./src/seed-templates.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "bun run ../../scripts/check-local-database.ts && drizzle-kit push",
    "db:seed": "bun run templates:seed --local",
    "db:start": "docker compose -f ../../compose.yaml up --wait db",
    "templates:seed": "bun run scripts/seed-templates.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^1.0.0-rc.5",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@texfolia/config": "workspace:*",
    "@types/bun": "^1.4.4",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^1.0.0-rc.5",
    "drizzle-seed": "1.0.0-rc.5",
    "typescript": "^6.0.2",
    "wrangler": "^4.70.0"
  }
}

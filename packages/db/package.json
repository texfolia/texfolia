{
  "name": "@texfolia/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./template-starters": "./src/template-starters.ts",
    "./seed-templates": "./src/seed-templates.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "dev:setup": "docker compose -f ../../compose.yaml up --wait db && bun run db:push",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@better-auth/stripe": "^1.7.14",
    "better-auth": "1.7.15",
    "drizzle-orm": "^1.0.0-rc.5",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@texfolia/typescript-config": "workspace:*",
    "@types/bun": "^1.4.4",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^1.0.0-rc.5",
    "drizzle-seed": "1.0.0-rc.5",
    "typescript": "^6.0.2"
  }
}

{
  "extends": "@texfolia/config/base.json",
  "include": ["src/**/*.ts", "src/**/*.tsx", "test/**/*.ts", "types/**/*.d.ts"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["bun"],
    "noUnusedLocals": true,
    "noUnusedParameters": true
  }
}

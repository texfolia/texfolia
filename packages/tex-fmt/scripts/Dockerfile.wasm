# Reproducible clean-room WASM build of upstream MIT tex-fmt (WGUNDERWOOD/tex-fmt).
FROM rust:1.88-bookworm AS builder

ARG TEX_FMT_VERSION=0.5.7
ARG WASM_BINDGEN_VERSION=0.2.114

RUN rustup target add wasm32-unknown-unknown \
  && cargo install --locked wasm-bindgen-cli --version "${WASM_BINDGEN_VERSION}"

WORKDIR /build

RUN curl -fsSL "https://github.com/WGUNDERWOOD/tex-fmt/archive/refs/tags/v${TEX_FMT_VERSION}.tar.gz" \
    | tar -xz --strip-components=1

RUN cargo build \
    --target wasm32-unknown-unknown \
    --release \
    --lib \
    --features wasm

RUN wasm-bindgen \
    --target web \
    --out-dir /out \
    --out-name tex_fmt \
    target/wasm32-unknown-unknown/release/tex_fmt.wasm

FROM scratch AS export
COPY --from=builder /out/tex_fmt.js /
COPY --from=builder /out/tex_fmt.d.ts /
COPY --from=builder /out/tex_fmt_bg.wasm /
COPY --from=builder /out/tex_fmt_bg.wasm.d.ts /

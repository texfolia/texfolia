@top Document { content* }

@skip { space | Comment }

@context envContext from "./tokens.js"

@external tokens inlineVerbatim from "./tokens.js" {
  InlineVerbatim
}

@external tokens beginCommand from "./tokens.js" {
  BeginCommand,
  BeginMathCommand,
  BeginVerbatimCommand
}

@external tokens verbatimContent from "./tokens.js" {
  VerbatimContent
}

@external tokens implicitEnd from "./tokens.js" {
  ImplicitEnd
}

content {
  VerbatimEnvironment |
  MathEnvironment |
  Environment |
  InlineVerbatim |
  DisplayMath |
  InlineMath |
  Command |
  OptionalArgument |
  BracedGroup |
  EscapedChar |
  Number |
  MathOperator |
  Text |
  Punctuation
}

VerbatimEnvironment {
  BeginVerbatimEnv verbatimBody EndEnv
}

@skip {} {
  verbatimBody { VerbatimContent? }
}

MathEnvironment {
  BeginMathEnv MathBody (EndEnv | ImplicitEnd)
}

MathBody {
  mathContent*
}

Environment {
  BeginEnv content* (EndEnv | ImplicitEnd)
}

BeginVerbatimEnv {
  BeginVerbatimCommand "{" EnvName "}"
}

BeginMathEnv {
  BeginMathCommand "{" EnvName "}"
}

BeginEnv {
  BeginCommand "{" EnvName "}"
}

EndEnv {
  endCommand "{" EnvName "}"
}

endCommand { @specialize[@name=EndCommand]<CommandName, "\\end"> }

EnvName {
  (Text | Number | MathOperator | Punctuation)+
}

DisplayMath {
  DoubleDollar mathContent* DoubleDollar |
  OpenDisplayMath mathContent* CloseDisplayMath
}

InlineMath {
  SingleDollar mathContent* SingleDollar |
  OpenInlineMath mathContent* CloseInlineMath
}

mathContent {
  VerbatimEnvironment |
  MathEnvironment |
  Environment |
  InlineVerbatim |
  Command |
  OptionalArgument |
  BracedGroup |
  EscapedChar |
  MathOperator |
  Number |
  Text |
  Punctuation
}

Command {
  CommandName
}

OptionalArgument {
  "[" bracketContent* "]"
}

bracketContent {
  InlineVerbatim |
  Command |
  BracedGroup |
  EscapedChar |
  InlineMath |
  MathOperator |
  Number |
  Text |
  Punctuation
}

BracedGroup {
  "{" content* "}"
}

@tokens {
  space { $[ \t\n\r]+ }
  Comment { "%" ![\n]* }

  DoubleDollar { "$$" }
  SingleDollar { "$" }
  OpenDisplayMath { "\\[" }
  CloseDisplayMath { "\\]" }
  OpenInlineMath { "\\(" }
  CloseInlineMath { "\\)" }

  CommandName { "\\" (@asciiLetter | "@")+ "*"? }
  EscapedChar { "\\" ![\n] }

  Number { $[0-9]+ ("." $[0-9]+)? }
  MathOperator { $[+\-*/=<>^_&|!] }
  Text { ![ \t\n\r%\\{}\[\]$+\-*/=<>^_&|!0-9,.?;:'"()~`]+ }
  Punctuation { $[,.?;:'"()~`]+ }

  "{" "}" "[" "]"

  @precedence {
    Comment,
    DoubleDollar,
    SingleDollar,
    OpenDisplayMath,
    CloseDisplayMath,
    OpenInlineMath,
    CloseInlineMath,
    CommandName,
    EscapedChar,
    Number,
    MathOperator,
    Punctuation,
    Text
  }
}

@external propSource latexHighlighting from "./highlight.js"

@detectDelim

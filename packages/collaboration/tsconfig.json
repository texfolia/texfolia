{
  "extends": "@texfolia/config/base.json",
  "include": [
    "src/index.ts",
    "src/browser.ts",
    "src/protocol.ts",
    "src/file.ts",
    "src/cache.ts",
    "src/drafts.ts",
    "src/usage.ts",
    "test/**/*.ts"
  ],
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["bun"],
    "noUnusedLocals": true,
    "noUnusedParameters": true
  }
}
